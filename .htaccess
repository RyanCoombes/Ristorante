# Browsers must check for a newer copy of pages, styles and scripts before using a saved one
# (unchanged files are answered with a quick "not modified", so the site stays fast).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
Options -Indexes

# Every visit to the public pages goes through api/gate.php, which shows "Apriamo presto"
# while the site is hidden behind the preview PIN (Gestione → Stato del sito → Prossimamente).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(index\.html|ordine\.html)?$ api/gate.php?vc_page=$1 [L,QSA]
</IfModule>
